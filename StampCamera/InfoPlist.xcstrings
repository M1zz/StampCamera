    "NSCameraUsageDescription" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펀칭기로 순간을 스티커로 뜯어내기 위해 카메라를 사용해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching uses the camera to turn moments into stickers with the puncher."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching uses the camera to turn moments into stickers with the puncher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching は、ひとときをステッカーにはがすためにカメラを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching 使用相机，把瞬间撕成贴纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching 使用相機，把瞬間撕成貼圖。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching использует камеру, чтобы превращать мгновения в стикеры."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching usa la cámara para convertir momentos en stickers."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching nutzt die Kamera, um Momente in Sticker zu verwandeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching utilise l’appareil photo pour transformer vos instants en autocollants."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완성된 스티커를 사진 앱에 저장하기 위해 사용해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to save finished stickers to your Photos."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to save finished stickers to your Photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成したステッカーを「写真」に保存するために使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于把完成的贴纸存储到“照片”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於將完成的貼圖儲存到「照片」。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы сохранять готовые стикеры в «Фото»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para guardar los stickers terminados en Fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um fertige Sticker in Fotos zu sichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à enregistrer les autocollants terminés dans Photos."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스티커에 뜯은 장소를 기록하기 위해 위치를 사용해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to record where a sticker was punched out."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to record where a sticker was punched out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーにはがした場所を記録するために位置情報を使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于记录贴纸是在哪里撕下的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於記錄貼圖是在哪裡撕下的。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы записывать место, где оторван стикер."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para registrar dónde se arrancó un sticker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um zu notieren, wo ein Sticker abgetrennt wurde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
