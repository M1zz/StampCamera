    "NSCameraUsageDescription" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펀칭기로 순간을 스티커로 뜯어내기 위해 카메라를 사용해요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching uses the camera to turn moments into stickers with the puncher."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching uses the camera to turn moments into stickers with the puncher."
          }
        },
        "ja" : {
          "stringUnit" : {
