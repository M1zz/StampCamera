          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте, чтобы приклеить его в любое место переписки. Анимированные стикеры приклеиваются в движении."
          }
        },
        "es" : {
          "stringUnit" : {
