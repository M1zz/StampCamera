    "꾹 눌러 대화 위 아무 데나 붙여요. 움직이는 스티커는 움직이며 붙어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrž prst a nalep ji kamkoli do konverzace. Pohyblivé nálepky se nalepí v pohybu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede for at sætte det fast et vilkårligt sted i samtalen. Bevægelige klistermærker bevæger sig, når de sættes fast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ihn gedrückt, um ihn irgendwo in der Unterhaltung aufzukleben. Bewegte Sticker bewegen sich beim Aufkleben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα πατημένο για να το κολλήσεις όπου θέλεις στη συνομιλία. Τα κινούμενα αυτοκόλλητα κολλάνε εν κινήσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold to place it anywhere on the conversation. Moving stickers move as they land."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold to place it anywhere on the conversation. Moving stickers move as they land."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado para pegarlo donde quieras en la conversación. Los stickers con movimiento se pegan en movimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä painettuna, niin voit liimata sen mihin tahansa keskusteluun. Liikkuvat tarrat liimautuvat liikkuen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt appuyé pour le coller où vous voulez dans la conversation. Les autocollants animés se collent en mouvement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan dan tahan untuk menempelkannya di mana saja dalam percakapan. Stiker bergerak akan menempel sambil bergerak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto per attaccarlo dove vuoi nella conversazione. Gli adesivi animati si attaccano in movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しして、会話の好きな場所に貼ります。動くステッカーは動いたまま貼れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꾹 눌러 대화 위 아무 데나 붙여요. 움직이는 스티커는 움직이며 붙어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne for å feste det hvor som helst i samtalen. Bevegelige klistremerker beveger seg når de festes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd ingedrukt om hem ergens in het gesprek te plakken. Stickers met beweging plakken in beweging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj, aby nakleić ją w dowolnym miejscu rozmowy. Ruchome naklejki przyklejają się w ruchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha pressionado para colar em qualquer lugar da conversa. Adesivos com movimento são colados em movimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте, чтобы приклеить его в любое место переписки. Анимированные стикеры приклеиваются в движении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll nedtryckt för att klistra fast det var som helst i konversationen. Rörliga klistermärken rör sig när de klistras fast."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะค้างเพื่อแปะตรงไหนก็ได้ในบทสนทนา สติกเกอร์ที่เคลื่อนไหวจะเคลื่อนไหวขณะแปะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmada istediğin yere yapıştırmak için basılı tut. Hareketli çıkartmalar hareket ederek yapışır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm giữ để dán vào bất kỳ chỗ nào trong cuộc trò chuyện. Nhãn dán chuyển động sẽ vừa dán vừa chuyển động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按即可把它贴到对话中的任意位置。动态贴纸会动着贴上去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按即可把它貼到對話中的任何位置。動態貼圖會動著貼上去。"
          }
        }
      }
    },
