    "입력창 옆 ＋ 단추를 누르고 ‘스티커’에서 펀칭 스티커를 골라요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력창 옆 ＋ 단추를 누르고 ‘스티커’에서 펀칭 스티커를 골라요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the ＋ button next to the text field, then pick a Punching sticker under “Stickers”."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the ＋ button next to the text field, then pick a Punching sticker under “Stickers”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力欄の横の＋ボタンをタップし、「ステッカー」からPunching のステッカーを選びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按输入框旁的 ＋ 按钮，在“贴纸”中选取 Punching 贴纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下輸入框旁的 ＋ 按鈕，在「貼圖」中選取 Punching 貼圖。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ＋ рядом с полем ввода и выберите стикер Punching в разделе «Стикеры»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón ＋ junto al campo de texto y elige un sticker de Punching en «Stickers»."
          }
        }
      }
    },
    "꾹 눌러 대화 위 아무 데나 붙여요. 움직이는 스티커는 움직이며 붙어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꾹 눌러 대화 위 아무 데나 붙여요. 움직이는 스티커는 움직이며 붙어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold to place it anywhere on the conversation. Moving stickers move as they land."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold to place it anywhere on the conversation. Moving stickers move as they land."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しして、会話の好きな場所に貼ります。動くステッカーは動いたまま貼れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按即可把它贴到对话中的任意位置。动态贴纸会动着贴上去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按即可把它貼到對話中的任何位置。動態貼圖會動著貼上去。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте, чтобы приклеить его в любое место переписки. Анимированные стикеры приклеиваются в движении."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado para pegarlo donde quieras en la conversación. Los stickers con movimiento se pegan en movimiento."
          }
        }
      }
    },
