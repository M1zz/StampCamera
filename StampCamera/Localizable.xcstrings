    },
    "순간을 스티커로 뜯으려면 카메라 권한이 필요해요.\n설정에서 카메라를 켜주세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "순간을 스티커로 뜯으려면 카메라 권한이 필요해요.\n설정에서 카메라를 켜주세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching needs camera access to turn moments into stickers.\nPlease turn on the camera in Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching needs camera access to turn moments into stickers.\nPlease turn on the camera in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとときをステッカーにするには、カメラへのアクセスが必要です。\n設定でカメラをオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用相机，才能把瞬间撕成贴纸。\n请在“设置”中开启相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用相機，才能把瞬間撕成貼圖。\n請在「設定」中開啟相機。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для превращения мгновений в стикеры Punching нужен доступ к камере.\nВключите камеру в настройках."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching necesita acceso a la cámara para convertir momentos en stickers.\nActiva la cámara en Ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching braucht Zugriff auf die Kamera, um Momente in Sticker zu verwandeln.\nBitte aktiviere die Kamera in den Einstellungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching a besoin d’accéder à l’appareil photo pour transformer vos instants en autocollants.\nActivez l’appareil photo dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching ha bisogno della fotocamera per trasformare i momenti in adesivi.\nAttiva la fotocamera in Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Punching precisa de acesso à câmera para transformar momentos em adesivos.\nAtive a câmera em Ajustes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching heeft toegang tot de camera nodig om momenten in stickers te veranderen.\nZet de camera aan in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching potrzebuje dostępu do aparatu, aby zamieniać chwile w naklejki.\nWłącz aparat w Ustawieniach."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching, anları çıkartmaya dönüştürmek için kameraya erişmek ister.\nLütfen Ayarlar’da kamerayı aç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching cần quyền truy cập camera để biến khoảnh khắc thành nhãn dán.\nHãy bật camera trong Cài đặt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Punching χρειάζεται πρόσβαση στην κάμερα για να μετατρέπει στιγμές σε αυτοκόλλητα.\nΕνεργοποίησε την κάμερα στις Ρυθμίσεις."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching tarvitsee pääsyn kameraan muuttaakseen hetket tarroiksi.\nOta kamera käyttöön Asetuksissa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching ต้องใช้กล้องเพื่อเปลี่ยนช่วงเวลาให้เป็นสติกเกอร์\nโปรดเปิดกล้องในการตั้งค่า"
          }
        },
        "cs" : {
          "stringUnit" : {
