        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인쇄용 스티커 시트에서 오려낸 스티커는 우표 모양이 아니라 오려낸 윤곽 그대로 칼선이 들어가요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
