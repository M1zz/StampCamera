    "카메라에서 펀칭기를 꾹 눌렀다 놓으면 찰칵! 창에 보이던 장면이 그대로 스티커로 뜯겨요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라에서 펀칭기를 꾹 눌렀다 놓으면 찰칵! 창에 보이던 장면이 그대로 스티커로 뜯겨요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the puncher in the camera, then let go. Click! Whatever was in the window is punched out as a sticker."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the puncher in the camera, then let go. Click! Whatever was in the window is punched out as a sticker."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラでパンチを長押しして、離すとカシャッ！ 窓に映っていた場面がそのままステッカーになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相机里长按打孔器，再松开，咔嚓！窗口里的画面就原样撕成了贴纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在相機裡長按打孔器，再放開，喀嚓！視窗裡的畫面就原樣撕成了貼圖。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте дырокол в камере, затем отпустите — щёлк! Всё, что было в окошке, оторвётся стикером."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el perforador en la cámara y suéltalo. ¡Clic! Lo que se veía en la ventana se arranca tal cual como sticker."
          }
        }
      }
    },
    "색감 고르기" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색감 고르기"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a Look"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a Look"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色合いを選ぶ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选个色调"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挑個色調"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите стиль"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un tono"
          }
        }
      }
    },
    "갓 나온 스티커 카드에 한 마디를 적고, ‘자세히’에서 세피아·흑백 같은 색감을 입혀보세요. 색감은 언제든 바꿔도 화질이 상하지 않아요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갓 나온 스티커 카드에 한 마디를 적고, ‘자세히’에서 세피아·흑백 같은 색감을 입혀보세요. 색감은 언제든 바꿔도 화질이 상하지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write a few words on your fresh sticker card, then tap “More” to add a look like sepia or black and white. You can change the look any time without losing quality."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write a few words on your fresh sticker card, then tap “More” to add a look like sepia or black and white. You can change the look any time without losing quality."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できたてのステッカーカードにひとことを書き、「詳細」でセピアやモノクロなどの色合いを付けてみましょう。色合いはいつでも変えられ、画質も落ちません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在刚出炉的贴纸卡上写句话，再到“详细”里加上棕褐、黑白之类的色调。色调随时可以更改，画质也不会受损。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在剛出爐的貼圖卡上寫句話，再到「詳細」裡加上棕褐、黑白之類的色調。色調隨時都能更改，畫質也不會受損。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите пару слов на только что созданной карточке стикера, затем в разделе «Ещё» добавьте стиль — например, сепию или чёрно-белый. Стиль можно менять в любой момент без потери качества."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe unas palabras en la tarjeta del sticker recién hecho y, en «Más», añade un tono como sepia o blanco y negro. Puedes cambiar el tono cuando quieras sin perder calidad."
          }
        }
      }
    },
    "수집함에 모으기" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수집함에 모으기"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect in a Book"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect in a Book"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブックに集める"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收进收藏册"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收進收藏冊"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соберите в альбом"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reúnelos en un álbum"
          }
        }
      }
    },
    "스티커 시트는 수집함 단위로 만들어져요. 인쇄하고 싶은 스티커를 한 수집함에 모으세요 — 수집함에서 ‘선택’ 후 ‘옮기기’로 한 번에 옮길 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스티커 시트는 수집함 단위로 만들어져요. 인쇄하고 싶은 스티커를 한 수집함에 모으세요 — 수집함에서 ‘선택’ 후 ‘옮기기’로 한 번에 옮길 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticker sheets are made one book at a time. Gather the stickers you want to print in one book — in the book, tap “Select”, then “Move” to move many at once."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticker sheets are made one book at a time. Gather the stickers you want to print in one book — in the book, tap “Select”, then “Move” to move many at once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーシートはブック単位で作られます。印刷したいステッカーを1つのブックに集めましょう。ブックで「選択」してから「移動」を押すと、まとめて移せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴纸页是以收藏册为单位制作的。把想打印的贴纸收进同一个收藏册吧——在收藏册里点“选择”，再点“移动”，就能一次移走多张。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼紙頁是以收藏冊為單位製作的。把想列印的貼圖收進同一個收藏冊吧——在收藏冊裡點「選取」，再點「移動」，就能一次移走多張。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Листы стикеров создаются по одному альбому. Соберите стикеры, которые хотите напечатать, в одном альбоме: в альбоме нажмите «Выбрать», затем «Переместить», чтобы перенести сразу много."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las hojas de stickers se hacen por álbum. Junta en un álbum los stickers que quieras imprimir: en el álbum toca «Seleccionar» y luego «Mover» para pasar muchos de una vez."
          }
        }
      }
    },
    "인쇄용 시트 만들기" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
