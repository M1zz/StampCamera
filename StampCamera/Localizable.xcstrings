        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a notification with the stickers you made on this day last year."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a notification with the stickers you made on this day last year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe una notificación con los stickers que arrancaste un día como hoy el año pasado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
