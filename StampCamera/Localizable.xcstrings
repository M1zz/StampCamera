    "화면 가득 찍은 뒤 원하는 것만 골라 스티커로 만들어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyfoťte celou obrazovku a nálepku udělejte jen z toho, co chcete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag et billede i fuld skærm, og lav kun det, du vil have, til et klistermærke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm das ganze Bild auf und mach nur aus dem, was du möchtest, einen Sticker."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τραβήξτε σε πλήρη οθόνη και κάντε αυτοκόλλητο μόνο αυτό που θέλετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a full-screen photo, then turn just the part you want into a sticker."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a full-screen photo, then turn just the part you want into a sticker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz la foto a pantalla completa y convierte en sticker solo lo que quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota koko näytön kuva ja tee tarra vain siitä, mitä haluat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez la photo en plein écran, puis ne gardez en sticker que ce que vous voulez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potret sepenuh layar, lalu jadikan stiker hanya bagian yang kamu mau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta a tutto schermo e trasforma in sticker solo ciò che vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面いっぱいに撮ってから、欲しいものだけ選んでステッカーにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 가득 찍은 뒤 원하는 것만 골라 스티커로 만들어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta et bilde i fullskjerm, og lag klistremerke av bare det du vil ha."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een schermvullende foto en maak alleen van wat je wilt een sticker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób zdjęcie na całym ekranie i zamień w naklejkę tylko to, co chcesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire a foto em tela cheia e transforme em figurinha só o que você quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте снимок во весь экран и превратите в стикер только то, что нужно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta en bild i helskärm och gör klistermärke av bara det du vill ha."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ่ายเต็มจอ แล้วเลือกเฉพาะสิ่งที่ต้องการมาทำเป็นสติกเกอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam ekran çek, sonra yalnızca istediğini çıkartmaya dönüştür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chụp toàn màn hình rồi chỉ biến thứ bạn muốn thành nhãn dán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先拍下整个画面，再只挑想要的做成贴纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先拍下整個畫面，再只挑想要的做成貼圖。"
          }
        }
      }
    },
    "화면 읽기 기능이 단추와 스티커를 빠짐없이, 알맞은 순서로 읽어 줘요." : {
      "comment" : "Roadmap item detail: better VoiceOver support",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver přečte každé tlačítko i každou nálepku, nic nevynechá a ve správném pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver læser hver knap og hvert klistermærke op uden at springe noget over og i den rigtige rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver liest jede Taste und jeden Sticker vollständig und in der richtigen Reihenfolge vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το VoiceOver διαβάζει κάθε κουμπί και κάθε αυτοκόλλητο, χωρίς παραλείψεις και με τη σωστή σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every button and sticker, in the right order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every button and sticker, in the right order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lee todos los botones y stickers, sin saltarse ninguno y en el orden correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lukee jokaisen painikkeen ja tarran, yhtäkään ohittamatta ja oikeassa järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lit chaque bouton et chaque autocollant, sans en oublier et dans le bon ordre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver membacakan setiap tombol dan stiker tanpa terlewat dan dalam urutan yang benar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver legge ogni pulsante e ogni adesivo, senza saltarne nessuno e nell’ordine giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面読み上げが、ボタンやステッカーをもれなく正しい順番で読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 읽기 기능이 단추와 스티커를 빠짐없이, 알맞은 순서로 읽어 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver leser opp hver knapp og hvert klistremerke uten å hoppe over noe og i riktig rekkefølge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver leest elke knop en elke sticker voor, zonder iets over te slaan en in de juiste volgorde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver czyta każdy przycisk i każdą naklejkę, niczego nie pomijając i w odpowiedniej kolejności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceOver lê cada botão e cada adesivo, sem pular nenhum e na ordem certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver зачитывает каждую кнопку и каждый стикер, ничего не пропуская и в правильном порядке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver läser upp varje knapp och varje klistermärke utan att hoppa över något och i rätt ordning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver อ่านทุกปุ่มและทุกสติกเกอร์ไม่ตกหล่นและเรียงลำดับถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver her düğmeyi ve her çıkartmayı eksiksiz, doğru sırayla okur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver đọc đủ từng nút và từng nhãn dán, theo đúng thứ tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旁白会按合适的顺序读出每个按钮和贴纸，一个不漏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旁白會依合適的順序讀出每個按鈕和貼圖，一個不漏。"
          }
        }
      }
    },
