            "value" : "6ステップで、スマホの中のステッカーが机の上のステッカーになります。"
          }
        }
      }
    },
    "알아두면 좋아요" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알아두면 좋아요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good to Know"
          }
        },
