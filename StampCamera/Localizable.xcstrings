    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: Dynamic Type layouts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字サイズを大きくしても、見切れずに見やすく配置し直されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字体后，界面也会重新排版，不会被截断，看起来依然舒服。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字體後，畫面也會重新排版，不會被截斷，看起來依然舒服。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При увеличении текста экраны перестраиваются, ничего не обрезается и всё удобно читать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al agrandar el texto, las pantallas se reorganizan sin cortarse y se ven bien."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei größerer Schrift werden die Bildschirme neu angeordnet, nichts wird abgeschnitten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous agrandissez le texte, les écrans se réorganisent sans être coupés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ingrandisci il testo, le schermate si riorganizzano senza tagliare nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o texto, as telas se reorganizam sem cortar nada."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de tekst vergroot, worden schermen netjes opnieuw ingedeeld zonder dat er iets wordt afgekapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po powiększeniu tekstu ekrany układają się na nowo i nic nie jest ucinane."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazıyı büyüttüğünde ekranlar kesilmeden yeniden düzenlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn phóng to chữ, màn hình tự sắp xếp lại và không bị cắt mất."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μεγαλώνεις το κείμενο, οι οθόνες αναδιατάσσονται χωρίς να κόβεται τίποτα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun suurennat tekstiä, näytöt järjestyvät uudelleen eikä mitään leikkaudu pois."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายตัวอักษร หน้าจอจะจัดเรียงใหม่โดยไม่ถูกตัด"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když zvětšíš text, obrazovky se přeskupí a nic se neuřízne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gør teksten større, ordnes skærmene om, så intet bliver skåret af."
          }
        }
      }
    },
