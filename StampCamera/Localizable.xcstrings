    "내 취향대로 꾸미고, 진짜 스티커로 뽑아 붙이세요. 연 구독이나 평생 중에 고르세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ozdob si alba podle sebe a vytiskni skutečné nálepky. Vyber si roční předplatné, nebo doživotní nákup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pynt dine album, som du vil, og print rigtige klistermærker. Vælg årligt eller livstid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestalte deine Sammlungen nach deinem Geschmack und drucke echte Sticker. Wähle jährlich oder lebenslang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διακόσμησε τα άλμπουμ σου όπως θέλεις και τύπωσε αληθινά αυτοκόλλητα. Διάλεξε ετήσια συνδρομή ή αγορά εφ’ όρου ζωής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decorate your books your way, then print real stickers. Choose yearly or lifetime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decorate your books your way, then print real stickers. Choose yearly or lifetime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decora tus álbumes a tu gusto e imprime stickers de verdad. Elige la suscripción anual o de por vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristele albumisi omalla tyylilläsi ja tulosta oikeita tarroja. Valitse vuositilaus tai elinikäinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décorez vos classeurs à votre goût, puis imprimez de vrais autocollants. Choisissez l’abonnement annuel ou l’achat à vie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hias album sesukamu, lalu cetak jadi stiker sungguhan. Pilih langganan tahunan atau seumur hidup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decora i tuoi album come vuoi e stampa adesivi veri. Scegli l’abbonamento annuale o l’acquisto a vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好みのままにデコって、本物のステッカーに印刷して貼りましょう。年額か買い切りを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 취향대로 꾸미고, 진짜 스티커로 뽑아 붙이세요. 연 구독이나 평생 중에 고르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pynt albumene dine slik du vil, og skriv ut ekte klistremerker. Velg årlig eller livstid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versier je verzamelingen zoals jij wilt en print echte stickers. Kies jaarlijks of levenslang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ozdabiaj albumy po swojemu i drukuj prawdziwe naklejki. Wybierz subskrypcję roczną albo dostęp dożywotni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decore seus álbuns do seu jeito e imprima adesivos de verdade. Escolha a assinatura anual ou o vitalício."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оформляйте альбомы на свой вкус и печатайте настоящие стикеры. Выберите подписку на год или покупку навсегда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dekorera dina album som du vill och skriv ut riktiga klistermärken. Välj årsvis eller livstid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตกแต่งอัลบั้มในแบบของคุณ แล้วพิมพ์ออกมาเป็นสติกเกอร์จริง เลือกได้ทั้งแบบรายปีหรือตลอดชีพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koleksiyonlarını zevkine göre süsle, sonra gerçek çıkartma olarak bastır. Yıllık abonelik ya da ömür boyu seçeneğini seç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trang trí bộ sưu tập theo ý bạn, rồi in ra nhãn dán thật. Chọn gói theo năm hoặc trọn đời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按自己的喜好装饰，再打印成真正的贴纸贴起来。可以选择年订阅或永久版。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照自己的喜好裝飾，再印成真正的貼紙貼起來。可以選擇年訂閱或永久版。"
          }
        }
      }
    },
