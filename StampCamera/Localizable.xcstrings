    "오려낼 대상이 없어 우표 모양으로 뜯었어요" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오려낼 대상이 없어 우표 모양으로 뜯었어요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to cut out, so it was punched out as a stamp"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing to cut out, so it was punched out as a stamp"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り抜く対象がないため、切手の形ではがしました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可抠出的主体，已撕成邮票形状"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可去背的主體，已撕成郵票形狀"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вырезать было нечего, поэтому кадр оторван маркой"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No había nada que recortar, así que se arrancó con forma de sello"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zum Ausschneiden – als Briefmarke abgetrennt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à détourer : détaché en forme de timbre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente da ritagliare: staccato a forma di francobollo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada para recortar, então foi destacado em forma de selo"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets om uit te knippen, daarom afgescheurd als postzegel"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie było czego wyciąć, więc oderwano w kształcie znaczka"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesilecek bir şey olmadığından pul şeklinde koparıldı"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì để cắt nên đã bấm thành hình tem"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
