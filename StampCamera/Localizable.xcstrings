            "value" : "잘못 오려진 곳을 지우거나 되살려 스티커를 다듬어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visk bort eller hent tilbake det som ble klippet ut feil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gum verkeerd uitgesneden stukjes weg of haal ze terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
