    "카메라에서 펀칭기를 꾹 눌렀다 놓으면 찰칵! 창에 보이던 장면이 그대로 스티커로 뜯겨요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라에서 펀칭기를 꾹 눌렀다 놓으면 찰칵! 창에 보이던 장면이 그대로 스티커로 뜯겨요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the puncher in the camera, then let go. Click! Whatever was in the window is punched out as a sticker."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold the puncher in the camera, then let go. Click! Whatever was in the window is punched out as a sticker."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラでパンチを長押しして、離すとカシャッ！ 窓に映っていた場面がそのままステッカーになります。"
          }
        }
      }
    },
    "색감 고르기" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색감 고르기"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a Look"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a Look"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色合いを選ぶ"
          }
        }
      }
    },
    "갓 나온 스티커 카드에 한 마디를 적고, ‘자세히’에서 세피아·흑백 같은 색감을 입혀보세요. 색감은 언제든 바꿔도 화질이 상하지 않아요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갓 나온 스티커 카드에 한 마디를 적고, ‘자세히’에서 세피아·흑백 같은 색감을 입혀보세요. 색감은 언제든 바꿔도 화질이 상하지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write a few words on your fresh sticker card, then tap “More” to add a look like sepia or black and white. You can change the look any time without losing quality."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write a few words on your fresh sticker card, then tap “More” to add a look like sepia or black and white. You can change the look any time without losing quality."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "できたてのステッカーカードにひとことを書き、「詳細」でセピアやモノクロなどの色合いを付けてみましょう。色合いはいつでも変えられ、画質も落ちません。"
          }
        }
      }
    },
    "수집함에 모으기" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수집함에 모으기"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect in a Book"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect in a Book"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブックに集める"
          }
        }
      }
    },
    "스티커 시트는 수집함 단위로 만들어져요. 인쇄하고 싶은 스티커를 한 수집함에 모으세요 — 수집함에서 ‘선택’ 후 ‘옮기기’로 한 번에 옮길 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스티커 시트는 수집함 단위로 만들어져요. 인쇄하고 싶은 스티커를 한 수집함에 모으세요 — 수집함에서 ‘선택’ 후 ‘옮기기’로 한 번에 옮길 수 있어요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticker sheets are made one book at a time. Gather the stickers you want to print in one book — in the book, tap “Select”, then “Move” to move many at once."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticker sheets are made one book at a time. Gather the stickers you want to print in one book — in the book, tap “Select”, then “Move” to move many at once."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーシートはブック単位で作られます。印刷したいステッカーを1つのブックに集めましょう。ブックで「選択」してから「移動」を押すと、まとめて移せます。"
          }
        }
      }
    },
    "인쇄용 시트 만들기" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인쇄용 시트 만들기"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a Printable Sheet"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a Printable Sheet"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "印刷用シートを作る"
          }
        }
      }
    },
    "수집함 오른쪽 위 ⋯ 메뉴 → ‘쓰기’ → ‘인쇄용 스티커 시트 (PDF)’. 인쇄소에 바로 건넬 수 있는 300dpi PDF가 만들어져요. ‘파일에 저장’으로 보관하거나 AirDrop·메일로 보내세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수집함 오른쪽 위 ⋯ 메뉴 → ‘쓰기’ → ‘인쇄용 스티커 시트 (PDF)’. 인쇄소에 바로 건넬 수 있는 300dpi PDF가 만들어져요. ‘파일에 저장’으로 보관하거나 AirDrop·메일로 보내세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the book’s ⋯ menu at the top right ▸ “Use” ▸ “Printable Sticker Sheet (PDF)”. You get a 300 dpi PDF you can hand straight to a print shop. Save it with “Save to Files”, or send it by AirDrop or email."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the book’s ⋯ menu at the top right ▸ “Use” ▸ “Printable Sticker Sheet (PDF)”. You get a 300 dpi PDF you can hand straight to a print shop. Save it with “Save to Files”, or send it by AirDrop or email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブック右上の⋯メニュー →「使う」→「印刷用ステッカーシート（PDF）」。印刷店にそのまま渡せる300dpiのPDFができます。「ファイルに保存」で保管したり、AirDropやメールで送ったりできます。"
          }
        }
      }
    },
    "인쇄하기" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
