    },
    "여섯 걸음이면 휴대폰 속 스티커가 책상 위 스티커가 돼요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여섯 걸음이면 휴대폰 속 스티커가 책상 위 스티커가 돼요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
