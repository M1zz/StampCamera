    "모은 스티커를 원본 사진과 함께 파일 하나로 꺼내 둘 수 있어요. 가져오기는 더하기만 하고 지금 있는 스티커는 지우지 않아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulož všechny nálepky i s původními fotkami do jednoho souboru. Import jen přidává – stávající nálepky se nemažou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem alle dine klistermærker, med de originale billeder, i én fil. Import tilføjer kun – dem, du allerede har, bliver ikke slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere alle Sticker samt Originalfotos in einer einzigen Datei. Beim Importieren wird nur hinzugefügt – vorhandene Sticker bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθήκευσε όλα τα αυτοκόλλητά σου, μαζί με τις αρχικές φωτογραφίες, σε ένα αρχείο. Η εισαγωγή μόνο προσθέτει· όσα έχεις ήδη δεν διαγράφονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your stickers, with their original photos, into a single file. Importing only adds stickers and never removes the ones you have."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save all your stickers, with their original photos, into a single file. Importing only adds stickers and never removes the ones you have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todos tus stickers, con sus fotos originales, en un solo archivo. Al importar solo se añaden: los que ya tienes no se borran."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna kaikki tarrasi alkuperäisine kuvineen yhteen tiedostoon. Tuonti vain lisää tarroja – nykyisiä ei poisteta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez tous vos autocollants, avec leurs photos d’origine, dans un seul fichier. L’importation ne fait qu’ajouter : vos autocollants actuels ne sont jamais supprimés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan semua stikermu beserta foto aslinya dalam satu file. Impor hanya menambahkan; stiker yang sudah ada tidak dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva tutti i tuoi adesivi, con le foto originali, in un unico file. L’importazione aggiunge soltanto: quelli che hai già non vengono eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集めたステッカーを元の写真と一緒に、ひとつのファイルに書き出せます。読み込みは追加するだけで、今あるステッカーは消えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모은 스티커를 원본 사진과 함께 파일 하나로 꺼내 둘 수 있어요. 가져오기는 더하기만 하고 지금 있는 스티커는 지우지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre alle klistremerkene dine, med originalbildene, i én fil. Import legger bare til – de du allerede har, blir ikke slettet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar al je stickers, met de originele foto’s, in één bestand. Importeren voegt alleen toe; de stickers die je al hebt, blijven staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz wszystkie naklejki razem z oryginalnymi zdjęciami w jednym pliku. Import tylko dodaje – obecne naklejki nie są usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve todos os seus adesivos, com as fotos originais, em um único arquivo. A importação só adiciona: os que você já tem não são apagados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните все стикеры вместе с исходными фото в одном файле. При импорте стикеры только добавляются — имеющиеся не удаляются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara alla dina klistermärken, med originalbilderna, i en enda fil. Import lägger bara till – de du redan har tas aldrig bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกสติกเกอร์ทั้งหมดพร้อมรูปต้นฉบับไว้ในไฟล์เดียว การนำเข้าจะเพิ่มเข้ามาเท่านั้น ไม่ลบสติกเกอร์ที่มีอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm çıkartmalarını özgün fotoğraflarıyla birlikte tek bir dosyaya kaydet. İçe aktarma yalnızca ekler; mevcut çıkartmaların silinmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu tất cả nhãn dán cùng ảnh gốc vào một tệp duy nhất. Khi nhập, nhãn dán chỉ được thêm vào; những nhãn dán hiện có không bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以把收集的贴纸连同原始照片导出为一个文件。导入只会添加，不会删除现有的贴纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以把收集的貼圖連同原始照片匯出為一個檔案。匯入只會加入，不會刪除現有的貼圖。"
          }
        }
      }
    },
    "모은 스티커를 진짜 스티커 용지로 뽑아 다이어리에 붙이세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytiskni nasbírané nálepky na skutečný samolepicí papír a nalep si je do deníku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print dine klistermærker på rigtigt klistermærkepapir, og sæt dem i din dagbog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drucke deine gesammelten Sticker auf echtes Stickerpapier und klebe sie in dein Tagebuch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τύπωσε τα αυτοκόλλητά σου σε αληθινό αυτοκόλλητο χαρτί και κόλλησέ τα στο ημερολόγιό σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print your collected stickers on real sticker paper and put them in your journal."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print your collected stickers on real sticker paper and put them in your journal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprime tus stickers en papel adhesivo de verdad y pégalos en tu agenda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulosta keräämäsi tarrat oikealle tarrapaperille ja liimaa ne päiväkirjaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprimez vos autocollants sur du vrai papier adhésif et collez-les dans votre carnet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cetak stiker koleksimu di kertas stiker sungguhan dan tempel di jurnalmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stampa gli adesivi raccolti su vera carta adesiva e attaccali nella tua agenda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集めたステッカーを本物のステッカー用紙に印刷して、手帳に貼りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
