          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しして、会話の好きな場所に貼ります。動くステッカーは動いたまま貼れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
