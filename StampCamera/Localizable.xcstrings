    "스티커는 기기 안에서만 오가요. 키보드는 입력한 글자를 읽거나 보내지 않아요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스티커는 기기 안에서만 오가요. 키보드는 입력한 글자를 읽거나 보내지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stickers only travel within your device. The keyboard never reads or sends what you type."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stickers only travel within your device. The keyboard never reads or sends what you type."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーはデバイスの中だけでやり取りされます。キーボードが入力した文字を読み取ったり送信したりすることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴纸只在你的设备内传递。键盘不会读取或发送你输入的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼圖只會在你的裝置內傳遞。鍵盤不會讀取或傳送你輸入的內容。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стикеры передаются только внутри вашего устройства. Клавиатура не читает и не отправляет то, что вы набираете."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los stickers solo circulan dentro de tu dispositivo. El teclado no lee ni envía lo que escribes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticker werden nur innerhalb deines Geräts übertragen. Die Tastatur liest oder sendet nicht, was du tippst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autocollants ne circulent que dans votre appareil. Le clavier ne lit ni n’envoie ce que vous saisissez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli adesivi circolano solo all’interno del tuo dispositivo. La tastiera non legge né invia ciò che scrivi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os adesivos só circulam dentro do seu aparelho. O teclado não lê nem envia o que você digita."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stickers gaan alleen binnen je apparaat heen en weer. Het toetsenbord leest of verstuurt niet wat je typt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naklejki krążą tylko w obrębie Twojego urządzenia. Klawiatura nie odczytuje ani nie wysyła tego, co wpisujesz."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkartmalar yalnızca cihazının içinde dolaşır. Klavye yazdıklarını okumaz ve göndermez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhãn dán chỉ đi lại bên trong thiết bị của bạn. Bàn phím không đọc hay gửi những gì bạn gõ."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αυτοκόλλητα κινούνται μόνο μέσα στη συσκευή σου. Το πληκτρολόγιο δεν διαβάζει και δεν στέλνει ό,τι πληκτρολογείς."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarrat liikkuvat vain laitteesi sisällä. Näppäimistö ei lue eikä lähetä kirjoittamaasi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สติกเกอร์เดินทางอยู่ภายในอุปกรณ์ของคุณเท่านั้น คีย์บอร์ดไม่อ่านและไม่ส่งสิ่งที่คุณพิมพ์"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nálepky putují jen uvnitř tvého zařízení. Klávesnice nečte ani neodesílá, co píšeš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klistermærker bevæger sig kun inde på din enhed. Tastaturet læser eller sender ikke det, du skriver."
          }
        }
      }
    },
