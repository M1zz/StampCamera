    "뜯기, 담기, 메시지와 키보드로 보내기는 언제나 무료예요. 응원하기는 기능을 열지 않아요." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vysekávání, sbírání a posílání přes Zprávy a klávesnici je vždy zdarma. Spropitné neodemyká žádné funkce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stansning, samling og afsendelse via Beskeder og tastaturet er altid gratis. Drikkepenge låser ikke funktioner op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanzen, Sammeln und Senden über Nachrichten und die Tastatur sind immer gratis. Trinkgeld schaltet keine Funktionen frei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κόψιμο, η συλλογή και η αποστολή μέσω Μηνυμάτων και πληκτρολογίου είναι πάντα δωρεάν. Τα φιλοδωρήματα δεν ξεκλειδώνουν λειτουργίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching, collecting, and sending through Messages and the keyboard are always free. Tips don’t unlock features."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching, collecting, and sending through Messages and the keyboard are always free. Tips don’t unlock features."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troquelar, coleccionar y enviar por Mensajes y el teclado siempre es gratis. Las propinas no desbloquean funciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leikkaaminen, kerääminen ja lähettäminen Viesteillä ja näppäimistöllä ovat aina ilmaisia. Tippi ei avaa toimintoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découper, collectionner et envoyer via Messages et le clavier reste toujours gratuit. Les pourboires ne débloquent aucune fonction."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat, mengoleksi, dan mengirim lewat Pesan dan keyboard selalu gratis. Tip tidak membuka fitur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fustellare, collezionare e inviare con Messaggi e la tastiera è sempre gratis. Le mance non sbloccano funzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーを抜く、集める、メッセージやキーボードで送るのはずっと無料です。応援（チップ）で機能は解放されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뜯기, 담기, 메시지와 키보드로 보내기는 언제나 무료예요. 응원하기는 기능을 열지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stansing, samling og sending via Meldinger og tastaturet er alltid gratis. Tips låser ikke opp funksjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponsen, verzamelen en versturen via Berichten en het toetsenbord is altijd gratis. Fooien ontgrendelen geen functies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wycinanie, zbieranie i wysyłanie przez Wiadomości i klawiaturę są zawsze za darmo. Napiwki nie odblokowują funkcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destacar, colecionar e enviar pelo Mensagens e pelo teclado é sempre grátis. Gorjetas não desbloqueiam recursos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вырезать, собирать и отправлять стикеры через «Сообщения» и клавиатуру всегда бесплатно. Чаевые не открывают функций."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att stansa, samla och skicka via Meddelanden och tangentbordet är alltid gratis. Dricks låser inte upp funktioner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเจาะ สะสม และส่งผ่านข้อความกับคีย์บอร์ดใช้ได้ฟรีเสมอ การให้ทิปไม่ได้ปลดล็อกฟีเจอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesmek, toplamak ve Mesajlar ile klavyeden göndermek her zaman ücretsiz. Bahşiş özellik açmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm, sưu tầm và gửi qua Tin nhắn hay bàn phím luôn miễn phí. Ủng hộ không mở khóa tính năng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打孔、收集，以及通过信息和键盘发送，永远免费。打赏不会解锁功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打孔、收集，以及透過訊息和鍵盤傳送，永遠免費。贊助不會解鎖功能。"
          }
        }
      }
    },
