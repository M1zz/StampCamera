    "스티커는 기기 안에서만 오가요. 키보드는 입력한 글자를 읽거나 보내지 않아요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스티커는 기기 안에서만 오가요. 키보드는 입력한 글자를 읽거나 보내지 않아요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stickers only travel within your device. The keyboard never reads or sends what you type."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stickers only travel within your device. The keyboard never reads or sends what you type."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーはデバイスの中だけでやり取りされます。キーボードが入力した文字を読み取ったり送信したりすることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贴纸只在你的设备内传递。键盘不会读取或发送你输入的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼圖只會在你的裝置內傳遞。鍵盤不會讀取或傳送你輸入的內容。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стикеры передаются только внутри вашего устройства. Клавиатура не читает и не отправляет то, что вы набираете."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los stickers solo circulan dentro de tu dispositivo. El teclado no lee ni envía lo que escribes."
          }
        }
      }
    },
