    "위치를 허용하고 찍으면 찍은 자리에 스티커가 놓여요" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte při focení polohu a každá nálepka se objeví tam, kde vznikla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad lokalitet, når du fotograferer, så lander hvert klistermærke, hvor du tog det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Standort beim Fotografieren, dann landet jeder Sticker dort, wo du ihn aufgenommen hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την τοποθεσία κατά τη λήψη και κάθε αυτοκόλλητο θα εμφανίζεται εκεί που το τραβήξατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location while shooting, and each sticker lands where you took it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow location while shooting, and each sticker lands where you took it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la ubicación al hacer fotos y cada sticker aparecerá donde lo tomaste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
