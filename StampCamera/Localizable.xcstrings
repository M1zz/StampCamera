            "value" : "点線に沿ってハサミやカッティングマシンで切れば完成！ 封筒、手帳、ノートパソコン…どこにでも貼ってみてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿着虚线用剪刀或切割机剪下就完成啦！信封、手帐、笔记本电脑……贴哪里都行。"
          }
        },
        "zh-Hant" : {
