    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: Dynamic Type layouts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字サイズを大きくしても、見切れずに見やすく配置し直されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字体后，界面也会重新排版，不会被截断，看起来依然舒服。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字體後，畫面也會重新排版，不會被截斷，看起來依然舒服。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При увеличении текста экраны перестраиваются, ничего не обрезается и всё удобно читать."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al agrandar el texto, las pantallas se reorganizan sin cortarse y se ven bien."
          }
        }
      }
    },
