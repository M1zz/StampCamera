    "잘못 오려진 곳을 지우거나 되살려 스티커를 다듬어요." : {
      "comment" : "Roadmap item detail: touch up cut-out edges",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vygumuj nebo vrať špatně vyříznutá místa a nálepku dolaď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visk forkert udklippede steder væk, eller hent dem tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radiere falsch ausgeschnittene Stellen weg oder hole sie zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σβήσε ή επανάφερε όσα σημεία κόπηκαν λάθος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase or restore spots that were cut out wrong to tidy up a sticker."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase or restore spots that were cut out wrong to tidy up a sticker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra o recupera las zonas mal recortadas para pulir tu sticker."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhi tai palauta väärin leikatut kohdat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacez ou restaurez les zones mal détourées pour peaufiner un autocollant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus atau pulihkan bagian yang terpotong salah untuk merapikan stiker."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella o ripristina le parti ritagliate male per rifinire l’adesivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うまく切り抜けなかった部分を消したり戻したりして、ステッカーを整えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
