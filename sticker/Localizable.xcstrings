    "펀칭 앱에서 스티커를 뜯으면\n여기에 나타나요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펀칭 앱에서 스티커를 뜯으면\n여기에 나타나요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punch out stickers in Punching\nand they’ll show up here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punch out stickers in Punching\nand they’ll show up here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching でステッカーをはがすと、\nここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Punching 里撕下贴纸后，\n会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Punching 裡撕下貼圖後，\n會顯示在這裡。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оторвите стикеры в Punching —\nи они появятся здесь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranca stickers en Punching\ny aparecerán aquí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenne in Punching Sticker ab,\ndann erscheinen sie hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détachez des autocollants dans Punching\net ils apparaîtront ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stacca adesivi in Punching\ne compariranno qui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaque adesivos no Punching\ne eles aparecerão aqui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheur stickers af in Punching\nen ze verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oderwij naklejki w Punching,\na pojawią się tutaj."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching’de çıkartma kopar,\nburada görünsün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy bấm nhãn dán trong Punching\nvà chúng sẽ hiện ở đây."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόσπασε αυτοκόλλητα στο Punching\nκαι θα εμφανιστούν εδώ."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irrota tarroja Punchingissa,\nniin ne ilmestyvät tänne."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉีกสติกเกอร์ใน Punching\nแล้วจะแสดงที่นี่"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtrhni nálepky v Punching\na objeví se tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riv klistermærker af i Punching,\nså dukker de op her."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobek stiker di Punching\ndan stiker akan muncul di sini."
          }
        }
      }
    },
    "스티커를 공유하려면 ‘App Group’ 설정이 필요해요.\n(앱·확장 프로그램 서명 설정 확인)" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스티커를 공유하려면 ‘App Group’ 설정이 필요해요.\n(앱·확장 프로그램 서명 설정 확인)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing stickers requires the “App Group” setup.\n(Check the app and extension signing settings)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing stickers requires the “App Group” setup.\n(Check the app and extension signing settings)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーを共有するには「App Group」の設定が必要です。\n（アプリと拡張機能の署名設定を確認してください）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享贴纸需要设置“App Group”。\n（请检查 App 与扩展的签名设置）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享貼圖需要設定「App Group」。\n（請檢查 App 與延伸功能的簽署設定）"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы делиться стикерами, нужна настройка «App Group».\n(Проверьте настройки подписи приложения и расширений)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para compartir stickers hace falta configurar el «App Group».\n(Revisa los ajustes de firma de la app y de las extensiones)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Teilen von Sticker ist die „App Group“-Einrichtung nötig.\n(Prüfe die Signierungseinstellungen von App und Erweiterung)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage d’autocollants nécessite la configuration « App Group ».\n(Vérifiez les réglages de signature de l’app et de l’extension)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per condividere gli adesivi serve la configurazione «App Group».\n(Controlla le impostazioni di firma dell’app e dell’estensione)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para compartilhar adesivos é preciso configurar o “App Group”.\n(Confira os ajustes de assinatura do app e da extensão)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor het delen van stickers is de ‘App Group’-instelling nodig.\n(Controleer de ondertekeningsinstellingen van de app en extensie)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnianie naklejek wymaga konfiguracji „App Group”.\n(Sprawdź ustawienia podpisywania aplikacji i rozszerzeń)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çıkartmaları paylaşmak için “App Group” ayarı gerekir.\n(Uygulamanın ve uzantının imzalama ayarlarını kontrol et)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để chia sẻ nhãn dán cần thiết lập “App Group”.\n(Kiểm tra cài đặt ký của ứng dụng và tiện ích mở rộng)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κοινοποίηση αυτοκόλλητων απαιτεί ρύθμιση «App Group».\n(Έλεγξε τις ρυθμίσεις υπογραφής της εφαρμογής και της επέκτασης)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarrojen jakaminen vaatii ”App Group” -asetuksen.\n(Tarkista apin ja laajennuksen allekirjoitusasetukset)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแชร์สติกเกอร์ต้องตั้งค่า “App Group”\n(ตรวจสอบการตั้งค่าการลงนามของแอปและส่วนขยาย)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílení nálepek vyžaduje nastavení „App Group“.\n(Zkontroluj nastavení podepisování aplikace a rozšíření)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deling af klistermærker kræver opsætning af “App Group”.\n(Tjek signeringsindstillingerne for appen og udvidelsen)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbagi stiker memerlukan pengaturan “App Group”.\n(Periksa pengaturan penandatanganan aplikasi dan ekstensi)"
          }
        }
      }
    },
