    "스티커를 쓰려면 ‘전체 접근 허용’을 켜주세요.\n설정 ▸ 일반 ▸ 키보드 ▸ 펀칭 스티커 ▸ 전체 접근 허용" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스티커를 쓰려면 ‘전체 접근 허용’을 켜주세요.\n설정 ▸ 일반 ▸ 키보드 ▸ 펀칭 스티커 ▸ 전체 접근 허용"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use stickers, turn on “Allow Full Access”.\nSettings ▸ General ▸ Keyboard ▸ Punching Stickers ▸ Allow Full Access"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use stickers, turn on “Allow Full Access”.\nSettings ▸ General ▸ Keyboard ▸ Punching Stickers ▸ Allow Full Access"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーを使うには「フルアクセスを許可」をオンにしてください。\n設定 ▸ 一般 ▸ キーボード ▸ Punching ステッカー ▸ フルアクセスを許可"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用贴纸，请开启“允许完全访问”。\n设置 ▸ 通用 ▸ 键盘 ▸ Punching 贴纸 ▸ 允许完全访问"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用貼圖，請開啟「允許完整取用」。\n設定 ▸ 一般 ▸ 鍵盤 ▸ Punching 貼圖 ▸ 允許完整取用"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы пользоваться стикерами, включите «Разрешить полный доступ».\nНастройки ▸ Основные ▸ Клавиатура ▸ Стикеры Punching ▸ Разрешить полный доступ"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar los stickers, activa «Permitir acceso completo».\nAjustes ▸ General ▸ Teclado ▸ Punching Stickers ▸ Permitir acceso completo"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Sticker zu verwenden, aktiviere „Vollen Zugriff erlauben“.\nEinstellungen ▸ Allgemein ▸ Tastatur ▸ Punching Sticker ▸ Vollen Zugriff erlauben"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour utiliser les autocollants, activez « Autoriser l’accès complet ».\nRéglages ▸ Général ▸ Clavier ▸ Punching Autocollants ▸ Autoriser l’accès complet"
          }
        }
      }
    },
    "펀칭 앱에서 스티커를 뜯으면\n여기에 나타나요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펀칭 앱에서 스티커를 뜯으면\n여기에 나타나요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punch out stickers in Punching\nand they’ll show up here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punch out stickers in Punching\nand they’ll show up here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching でステッカーをはがすと、\nここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Punching 里撕下贴纸后，\n会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Punching 裡撕下貼圖後，\n會顯示在這裡。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оторвите стикеры в Punching —\nи они появятся здесь."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arranca stickers en Punching\ny aparecerán aquí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenne in Punching Sticker ab,\ndann erscheinen sie hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détachez des autocollants dans Punching\net ils apparaîtront ici."
          }
        }
      }
    },
