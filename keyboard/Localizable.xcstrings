            "value" : "全部"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部"
          }
        }
      }
    },
    "스티커를 쓰려면 ‘전체 접근 허용’을 켜주세요.\n설정 ▸ 일반 ▸ 키보드 ▸ 펀칭 스티커 ▸ 전체 접근 허용" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스티커를 쓰려면 ‘전체 접근 허용’을 켜주세요.\n설정 ▸ 일반 ▸ 키보드 ▸ 펀칭 스티커 ▸ 전체 접근 허용"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use stickers, turn on “Allow Full Access”.\nSettings ▸ General ▸ Keyboard ▸ Punching Stickers ▸ Allow Full Access"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use stickers, turn on “Allow Full Access”.\nSettings ▸ General ▸ Keyboard ▸ Punching Stickers ▸ Allow Full Access"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステッカーを使うには「フルアクセスを許可」をオンにしてください。\n設定 ▸ 一般 ▸ キーボード ▸ Punching ステッカー ▸ フルアクセスを許可"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用贴纸，请开启“允许完全访问”。\n设置 ▸ 通用 ▸ 键盘 ▸ Punching 贴纸 ▸ 允许完全访问"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用貼圖，請開啟「允許完整取用」。\n設定 ▸ 一般 ▸ 鍵盤 ▸ Punching 貼圖 ▸ 允許完整取用"
          }
        }
      }
    },
    "펀칭 앱에서 스티커를 뜯으면\n여기에 나타나요." : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펀칭 앱에서 스티커를 뜯으면\n여기에 나타나요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punch out stickers in Punching\nand they’ll show up here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punch out stickers in Punching\nand they’ll show up here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punching でステッカーをはがすと、\nここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Punching 里撕下贴纸后，\n会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Punching 裡撕下貼圖後，\n會顯示在這裡。"
          }
        }
      }
    },
    "복사됨 — 붙여넣기 하세요" : {
      "extractionState" : "manual",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사됨 — 붙여넣기 하세요"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied — now paste it"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied — now paste it"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしました — 貼り付けてください"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拷贝 — 请粘贴"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拷貝 — 請貼上"
